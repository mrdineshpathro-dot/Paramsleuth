# Scan databases and generated reports — never commit
*.sqlite
*.sqlite3
*.db
*.jsonl
reports/
output/
findings.*
scan_state.*
*.log

# Local config overrides
paramscout.local.toml

# Editor noise
.idea/
.vscode/
*.swp
.DS_Store
